# Optional authenticated Solana DEVNET RPC. Keep server-side.
# SOLANA_RPC_URL=https://your-devnet-rpc
# RPC_MIN_INTERVAL_MS=0
# Use a persistent directory in hosted deployments.
# DEMO_DATA_DIR=/data
# Required stable signing secret and exact origin when hosted.
# SESSION_SECRET=generate-a-random-32-byte-secret
# APP_ORIGIN=https://meteora.fyi
# APP_EXTRA_ORIGINS=https://www.meteora.fyi
# NEXT_PUBLIC_BASE_PATH=/demo
